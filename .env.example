# precedent-summarizer/.env.example
# 사용법: 이 파일을 복사해 같은 폴더에 ".env"로 저장한 뒤 값을 입력.
# 이 파일(.env.example)에는 실제 키 값을 넣지 말 것 — 변수명/형식 안내용 템플릿(git 커밋 대상).
# .env 는 .gitignore로 커밋에서 제외됨.

# =============================================================================
# [필수] API 키
# =============================================================================

# --- Anthropic Claude API (요약 엔진) ---
# 발급 경로: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# 워크스페이스에 속하지 않은(조직 범위) 키를 쓰는 경우에만 입력. 콘솔 Workspaces에서 확인(wrkspc_...)
# 워크스페이스 안에서 발급한 키라면 비워 둔다.
ANTHROPIC_WORKSPACE_ID=

# --- 국가법령정보센터(law.go.kr) Open API (판례 검색/본문 수집) ---
# 기존 CODE/.env 의 LAW_API_KEY와 동일 값(OC) 사용 가능
# 발급 경로: open.law.go.kr → API인증키관리
LAW_API_KEY=

# =============================================================================
# [선택] 실행 설정 — 비워두면 코드의 기본값 사용
# =============================================================================

# 요약 모델: 일반 판결용 / 장문·전원합의체 등 복잡 판결용 (P3 시범 결과로 확정 예정)
CLAUDE_MODEL_DEFAULT=claude-sonnet-5-5
CLAUDE_MODEL_COMPLEX=claude-opus-5-5

# 배치 누적 비용 상한(USD): 배치 실측 + 배치 외 API 비용(채점 등) + 미수거 배치 추정 ≤ 이 값 (D-023, 현재 85)
BATCH_BUDGET_USD=

# 로컬 데이터 경로 (기본: 프로젝트 내 data/)
DB_PATH=data/precedents.sqlite
RAW_CACHE_DIR=data/raw_cache
